model user_xp {
  id         String   @id
  user_id    String   @unique
  total_xp   Int      @default(0)
  level      Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime
  users      User     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "user_xp_user_fkey")
}

model xp_transactions {
  id           String   @id
  user_id      String
  amount       Int
  reason       String
  reference_id String?
  created_at   DateTime @default(now())
  users        User     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "xp_transactions_user_fkey")

  @@index([user_id])
}

enum ContentModerationStatus {
  PENDING
  APPROVED
  REJECTED
}
