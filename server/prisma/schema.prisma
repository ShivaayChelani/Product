generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  password               String?
  name                   String
  emailVerified          Boolean                @default(false) @map("email_verified")
  bio                    String?
  interests              String[]               @default([])
  avatarStyle            Int                    @default(0) @map("avatar_style")
  avatar                 String?
  verificationStatus     VerificationStatus     @default(NONE) @map("verification_status")
  verifiedAt             DateTime?              @map("verified_at")
  verifiedById           String?                @map("verified_by_id")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  badges                 String[]               @default([])
  permission             Role                   @default(USER)
  activeMode             Role                   @default(USER) @map("active_mode")
  razorpayCustomerId     String?                @map("razorpay_customer_id")
  aiGenerationLogs       AiGenerationLog[]
  announcementsCreated   Announcement[]         @relation("AnnouncementCreatedBy")
  appFeedback            AppFeedback[]
  authAccounts           AuthAccount[]
  audits                 AuditLog[]             @relation("AuditActor")
  completedChallenges    ChallengeCompletion[]
  createdChallenges      Challenge[]
  checkIns               CheckIn[]              @relation("UserCheckIns")
  collections            Collection[]           @relation("UserCollections")
  couponRedemptions      CouponRedemption[]
  creatorProfile         CreatorProfile?
  deviceTokens           DeviceToken[]
  followers              Follow[]               @relation("Followers")
  following              Follow[]               @relation("Following")
  notifications          InAppNotification[]
  invoices               Invoice[]
  legalVersionsAuthored  LegalDocumentVersion[] @relation("LegalVersionCreatedBy")
  legalVersionsPublished LegalDocumentVersion[] @relation("LegalVersionPublishedBy")
  paymentTransactions    PaymentTransaction[]
  stats                  PlaceStat[]            @relation("UserStats")
  approvedPlaces         Place[]                @relation("ApprovedPlaces")
  placesLastVerified     Place[]                @relation("PlaceLastVerifiedBy")
  submittedPlaces        Place[]                @relation("SubmittedPlaces")
  pointBalance           PointBalance?
  pointTransactions      PointTransaction[]
  refundedRedemptions    Redemption[]           @relation("RefundedRedemptions")
  redemptions            Redemption[]
  verifiedRedemptions    Redemption[]           @relation("VerifiedRedemptions")
  reelComments           ReelComment[]
  reelLikes              ReelLike[]
  reelReports            ReelReport[]
  reelSaves              ReelSave[]
  refreshTokens          RefreshToken[]
  refundsProcessed       Refund[]               @relation("RefundProcessor")
  refundsRequested       Refund[]               @relation("RefundRequester")
  reviews                Review[]               @relation("UserReviews")
  rewardClaims           RewardClaim[]
  riddleSubmissions      RiddleSubmission[]
  rideDestinations       RideDestination[]
  rideFavorites          RideFavorite[]
  rideHistory            RideHistory[]
  rideRequests           RideRequest[]
  collaborators          TripCollaborator[]
  tripPlans              TripPlan[]             @relation("UserTrips")
  userAppPreference      UserAppPreference?
  blocksReceived         UserBlock[]            @relation("UserBlocksReceived")
  blocksMade             UserBlock[]            @relation("UserBlocksMade")
  reviewedPlaceImages    UserPlaceImage[]       @relation("reviewer")
  userPlaceImages        UserPlaceImage[]
  approvedUserRoles      UserRole[]             @relation("UserRoleApprover")
  userRoles              UserRole[]             @relation("UserRoleAssignments")
  subscriptions          UserSubscription[]
  verifiedBy             User?                  @relation("VerifiedUsers", fields: [verifiedById], references: [id])
  verifiedUsers          User[]                 @relation("VerifiedUsers")
  approvedOffers         VendorOffer[]          @relation("ApprovedOffers")
  rejectedOffers         VendorOffer[]          @relation("RejectedOffers")
  vendorReviews          VendorReview[]         @relation("UserVendorReviews")
  reviewedVendors        Vendor[]               @relation("VendorReviewer")
  vendor                 Vendor?
  walletTransactions     WalletTransaction[]
  wallet                 Wallet?
  user_badges            user_badges[]
  user_streaks           user_streaks?
  user_xp                user_xp?
  xp_transactions        xp_transactions[]

  @@index([permission])
  @@index([activeMode])
  @@index([verificationStatus])
  @@index([createdAt])
  @@map("users")
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  email             String?
  emailVerified     Boolean? @map("email_verified")
  displayName       String?  @map("display_name")
  avatar            String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([email])
  @@map("auth_accounts")
}

model UserAppPreference {
  userId        String   @id @map("user_id")
  privacy       Json     @default("{}")
  notifications Json     @default("{}")
  security      Json     @default("{}")
  appearance    Json     @default("{}")
  language      String   @default("auto")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_app_preferences")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocked   User     @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("UserBlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model AppFeedback {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  category  String
  message   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([category])
  @@map("app_feedback")
}

/// Capability assignments for a single account (multi-role).
/// Source of truth for authz; User.permission is denormalized for dual-write.
model UserRole {
  id             String               @id @default(cuid())
  userId         String               @map("user_id")
  role           Role
  status         RoleAssignmentStatus
  approvedById   String?              @map("approved_by_id")
  approvedAt     DateTime?            @map("approved_at")
  rejectedReason String?              @map("rejected_reason")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  retiredAt      DateTime?            @map("retired_at")
  approvedBy     User?                @relation("UserRoleApprover", fields: [approvedById], references: [id])
  user           User                 @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role, status])
  @@index([userId])
  @@map("user_roles")
}

model Vendor {
  id                    String                   @id @default(cuid())
  userId                String                   @unique @map("user_id")
  businessName          String                   @map("business_name")
  businessType          String                   @map("business_type")
  phone                 String
  address               String
  city                  String
  state                 String
  latitude              Float?
  longitude             Float?
  description           String?
  imageUrl              String?                  @map("image_url")
  website               String?
  operatingHours        String?                  @map("operating_hours")
  images                String[]                 @default([])
  status                VendorStatus             @default(PENDING)
  rejectionReason       String?                  @map("rejection_reason")
  reviewedById          String?                  @map("reviewed_by_id")
  reviewedAt            DateTime?                @map("reviewed_at")
  linkedSpotIds         String[]                 @map("linked_spot_ids")
  services              Json?                    @map("services")
  showOnMap             Boolean                  @default(true) @map("show_on_map")
  showContact           Boolean                  @default(true) @map("show_contact")
  showWebsite           Boolean                  @default(true) @map("show_website")
  showImages            Boolean                  @default(true) @map("show_images")
  showOffers            Boolean                  @default(true) @map("show_offers")
  showReels             Boolean                  @default(true) @map("show_reels")
  showNavigation        Boolean                  @default(true) @map("show_navigation")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  vendorCode            String?                  @unique @map("vendor_code")
  gstNumber             String?                  @map("gst_number")
  documents             String[]                 @default([])
  rating                Float?
  reviewCount           Int                      @default(0) @map("review_count")
  subscriptionStatus    VendorSubscriptionStatus @default(NONE) @map("subscription_status")
  suspendedAt           DateTime?                @map("suspended_at")
  vendorCodeResetCount  Int                      @default(0) @map("vendor_code_reset_count")
  lastVendorCodeResetAt DateTime?                @map("last_vendor_code_reset_at")
  collaborations        Collaboration[]
  coupons               Coupon[]
  redemptions           Redemption[]
  socialReels           Reel[]
  rewards               RewardCatalog[]
  vendorDocuments       VendorDocument[]
  offers                VendorOffer[]
  palPointsPartner      VendorPalPointsPartner?
  reels                 VendorReel[]
  vendorReviews         VendorReview[]
  reviewedBy            User?                    @relation("VendorReviewer", fields: [reviewedById], references: [id])
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([city])
  @@index([state])
  @@index([businessType])
  @@index([latitude, longitude])
  @@index([createdAt])
  @@index([rating])
  @@map("vendors")
}

model VendorOffer {
  id                 String          @id @default(cuid())
  vendorId           String          @map("vendor_id")
  title              String
  description        String?
  discountType       String          @map("discount_type")
  discountValue      Float           @map("discount_value")
  pointsRequired     Int             @map("points_required")
  minBillAmount      Float?          @map("min_bill_amount")
  couponCode         String?         @map("coupon_code")
  dailyLimit         Int?            @map("daily_limit")
  validTill          String?         @map("valid_till")
  category           String?         @map("category")
  imageUrl           String?         @map("image_url")
  startDate          DateTime?       @map("start_date")
  maxRedemptions     Int?            @map("max_redemptions")
  currentRedemptions Int             @default(0) @map("current_redemptions")
  isFeatured         Boolean         @default(false) @map("is_featured")
  isApproved         Boolean         @default(false) @map("is_approved")
  approvedById       String?         @map("approved_by_id")
  approvedAt         DateTime?       @map("approved_at")
  isActive           Boolean         @default(true) @map("is_active")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  banner             String?         @map("banner")
  clickCount         Int             @default(0) @map("click_count")
  pausedAt           DateTime?       @map("paused_at")
  rejectedAt         DateTime?       @map("rejected_at")
  rejectedById       String?         @map("rejected_by_id")
  rejectionReason    String?         @map("rejection_reason")
  viewCount          Int             @default(0) @map("view_count")
  redemptions        Redemption[]
  catalogEntries     RewardCatalog[]
  approvedBy         User?           @relation("ApprovedOffers", fields: [approvedById], references: [id])
  rejectedBy         User?           @relation("RejectedOffers", fields: [rejectedById], references: [id])
  vendor             Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([category])
  @@index([isApproved, isActive])
  @@map("vendor_offers")
}

model VendorReel {
  id          String   @id @default(cuid())
  vendorId    String   @map("vendor_id")
  videoUrl    String   @map("video_url")
  thumbnail   String?
  title       String?
  description String?
  views       Int      @default(0)
  likes       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_reels")
}

model PointBalance {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  balance        Int      @default(0)
  lifetimeEarned Int      @default(0) @map("lifetime_earned")
  lifetimeSpent  Int      @default(0) @map("lifetime_spent")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("point_balances")
}

model PointTransaction {
  id          String          @id @default(cuid())
  userId      String?         @map("user_id")
  amount      Int
  reason      String
  referenceId String?         @map("reference_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  type        TransactionType @default(EARN)
  user        User?           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([userId, type, createdAt])
  @@map("point_transactions")
}

model Redemption {
  id            String           @id @default(cuid())
  userId        String?          @map("user_id")
  offerId       String?          @map("offer_id")
  vendorId      String?          @map("vendor_id")
  pointsSpent   Int              @map("points_spent")
  discountValue Float            @map("discount_value")
  discountType  String           @map("discount_type")
  qrCode        String           @unique @map("qr_code")
  receiptNumber String?          @unique @map("receipt_number")
  status        RedemptionStatus @default(PENDING)
  verifiedAt    DateTime?        @map("verified_at")
  verifiedById  String?          @map("verified_by_id")
  refundedAt    DateTime?        @map("refunded_at")
  refundedById  String?          @map("refunded_by_id")
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")
  token         RedemptionToken?
  offer         VendorOffer?     @relation(fields: [offerId], references: [id])
  refundedBy    User?            @relation("RefundedRedemptions", fields: [refundedById], references: [id])
  user          User?            @relation(fields: [userId], references: [id])
  vendor        Vendor?          @relation(fields: [vendorId], references: [id])
  verifiedBy    User?            @relation("VerifiedRedemptions", fields: [verifiedById], references: [id])

  @@index([offerId])
  @@index([userId])
  @@index([vendorId])
  @@index([qrCode])
  @@index([status])
  @@index([createdAt])
  @@index([status, offerId])
  @@map("redemptions")
}

model ReceiptSequence {
  year       Int @id
  lastNumber Int @default(0) @map("last_number")

  @@map("receipt_sequences")
}

model Wallet {
  id             String              @id @default(cuid())
  userId         String              @unique @map("user_id")
  palPoints      Int                 @default(0) @map("pal_points")
  lifetimeEarned Int                 @default(0) @map("lifetime_earned")
  lifetimeSpent  Int                 @default(0) @map("lifetime_spent")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  transactions   WalletTransaction[]
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id            String          @id @default(cuid())
  walletId      String?         @map("wallet_id")
  userId        String?         @map("user_id")
  amount        Int
  reason        String
  referenceId   String?         @map("reference_id")
  referenceType String?         @map("reference_type")
  metadata      Json?           @map("metadata")
  createdAt     DateTime        @default(now()) @map("created_at")
  type          TransactionType @default(EARN)
  user          User?           @relation(fields: [userId], references: [id])
  wallet        Wallet?         @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([userId])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model RedemptionToken {
  id           String     @id @default(cuid())
  redemptionId String     @unique @map("redemption_id")
  token        String     @unique
  expiresAt    DateTime   @map("expires_at")
  usedAt       DateTime?  @map("used_at")
  usedById     String?    @map("used_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  redemption   Redemption @relation(fields: [redemptionId], references: [id], onDelete: Cascade)

  @@map("redemption_tokens")
}

model PointRule {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  points      Int
  xpAmount    Int      @default(0) @map("xp_amount")
  category    String   @default("general")
  isActive    Boolean  @default(true) @map("is_active")
  cooldownSec Int?     @map("cooldown_sec")
  maxDaily    Int?     @map("max_daily")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category, isActive])
  @@map("point_rules")
}

model RewardCatalog {
  id             String       @id @default(cuid())
  title          String
  description    String?
  category       String
  pointsRequired Int          @map("points_required")
  value          String?
  imageUrl       String?      @map("image_url")
  vendorId       String?      @map("vendor_id")
  vendorOfferId  String?      @map("vendor_offer_id")
  isActive       Boolean      @default(true) @map("is_active")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  vendor         Vendor?      @relation(fields: [vendorId], references: [id])
  vendorOffer    VendorOffer? @relation(fields: [vendorOfferId], references: [id])

  @@index([category, isActive])
  @@index([pointsRequired])
  @@map("reward_catalog")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Place {
  id                       String                    @id @default(cuid())
  name                     String
  slug                     String                    @unique
  description              String
  shortDescription         String?                   @map("short_description")
  latitude                 Float?
  longitude                Float?
  category                 String
  tags                     String[]                  @default([])
  images                   String[]                  @default([])
  thumbnail                String?
  city                     String                    @default("")
  state                    String                    @default("")
  country                  String                    @default("India")
  rating                   Float?
  reviewCount              Int                       @default(0) @map("review_count")
  openingHours             Json?                     @map("opening_hours")
  ticketPrice              Json?                     @map("ticket_price")
  bestTimeToVisit          Json?                     @map("best_time_to_visit")
  bestTimeReason           String?                   @map("best_time_reason")
  hiddenGemScore           Float?                    @map("hidden_gem_score")
  popularityScore          Float?                    @map("popularity_score")
  verificationLevel        Int                       @default(0) @map("verification_level")
  status                   PlaceStatus               @default(PENDING)
  source                   PlaceSource               @default(HIDDEN_GEM)
  externalId               String?                   @unique @map("external_id")
  submittedById            String?
  approvedById             String?
  reviewedAt               DateTime?                 @map("reviewed_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  location                 Unsupported("geometry")?
  searchVector             Unsupported("tsvector")?  @map("search_vector")
  rejectionReason          String?                   @map("rejection_reason")
  accessibilityDetails     String?                   @map("accessibility_details")
  emergencyContact         String?                   @map("emergency_contact")
  hasParking               Boolean                   @default(false) @map("has_parking")
  hasWashroom              Boolean                   @default(false) @map("has_washroom")
  history                  String?
  isAccessible             Boolean                   @default(false) @map("is_accessible")
  isPetFriendly            Boolean                   @default(false) @map("is_pet_friendly")
  parkingDetails           String?                   @map("parking_details")
  recommendedDuration      String?                   @map("recommended_duration")
  website                  String?
  estimatedDurationMinutes Int?                      @map("estimated_duration_minutes")
  district                 String                    @default("")
  village                  String                    @default("")
  fullAddress              String?                   @map("full_address")
  subcategory              String?
  highlights               Json?
  searchKeywords           String[]                  @default([]) @map("search_keywords")
  dataQuality              PlaceDataQuality          @default(DRAFT) @map("data_quality")
  featuredScore            Float?                    @map("featured_score")
  verificationScore        Float?                    @map("verification_score")
  lastVerifiedAt           DateTime?                 @map("last_verified_at") @db.Timestamptz(6)
  googleMapsUrl            String?                   @map("google_maps_url")
  mergedIntoId             String?                   @map("merged_into_id")
  publicPlaceId            String?                   @unique @map("public_place_id")
  tehsil                   String                    @default("")
  postalCode               String                    @default("") @map("postal_code")
  elevationMeters          Float?                    @map("elevation_meters")
  geohash                  String?
  plusCode                 String?                   @map("plus_code")
  unescoStatus             String?                   @map("unesco_status")
  heritageStatus           String?                   @map("heritage_status")
  religiousType            String?                   @map("religious_type")
  naturalCultural          String?                   @map("natural_cultural")
  qualityScore             Float?                    @map("quality_score")
  confidenceScore          Float?                    @map("confidence_score")
  trendingScore            Float?                    @map("trending_score")
  bayesianRating           Float?                    @map("bayesian_rating")
  lastVerifiedById         String?                   @map("last_verified_by_id")
  embeddingStatus          PlaceEmbeddingStatus      @default(PENDING) @map("embedding_status")
  embeddingVersion         String?                   @map("embedding_version")
  embeddingUpdatedAt       DateTime?                 @map("embedding_updated_at")
  editorialPriority        Int                       @default(3) @map("editorial_priority")
  audits                   AuditLog[]
  checkIns                 CheckIn[]
  collections              CollectionPlace[]
  aliases                  PlaceAlias[]
  boundaryValidations      PlaceBoundaryValidation[]
  changeHistory            PlaceChangeHistory[]
  duplicateCandidatesA     PlaceDuplicateCandidate[] @relation("DupPlaceA")
  duplicateCandidatesB     PlaceDuplicateCandidate[] @relation("DupPlaceB")
  events                   PlaceEvent[]
  fieldProvenance          PlaceFieldProvenance[]
  placeImages              PlaceImage[]
  mergeEventsAsCanonical   PlaceMergeLog[]           @relation("MergeCanonical")
  mergeEventsAsMerged      PlaceMergeLog[]           @relation("MergeDuplicate")
  offers                   PlaceOffer[]
  qualityChecks            PlaceQualityCheck[]
  relationshipsFrom        PlaceRelationship[]       @relation("PlaceRelFrom")
  relationshipsTo          PlaceRelationship[]       @relation("PlaceRelTo")
  searchEmbedding          PlaceSearchEmbedding?
  stats                    PlaceStat[]
  translations             PlaceTranslation[]
  verificationLogs         PlaceVerificationLog[]
  versions                 PlaceVersion[]
  placeVideos              PlaceVideo[]
  approvedBy               User?                     @relation("ApprovedPlaces", fields: [approvedById], references: [id])
  lastVerifiedBy           User?                     @relation("PlaceLastVerifiedBy", fields: [lastVerifiedById], references: [id])
  mergedInto               Place?                    @relation("PlaceCanonicalMerge", fields: [mergedIntoId], references: [id])
  mergedDuplicates         Place[]                   @relation("PlaceCanonicalMerge")
  submittedBy              User?                     @relation("SubmittedPlaces", fields: [submittedById], references: [id])
  reels                    Reel[]
  reviews                  Review[]
  tripStops                TripPlanStop[]
  userPlaceImages          UserPlaceImage[]

  @@index([publicPlaceId])
  @@index([embeddingStatus])
  @@index([dataQuality])
  @@index([mergedIntoId])
  @@index([district])
  @@index([category])
  @@index([latitude, longitude])
  @@index([submittedById])
  @@index([source])
  @@index([externalId])
  @@index([city])
  @@index([state])
  @@index([city, state])
  @@index([popularityScore])
  @@index([hiddenGemScore])
  @@index([rating])
  @@index([createdAt])
  @@index([status, category])
  @@index([source, status])
  @@index([status, latitude, longitude])
  @@index([searchVector], type: Gin)
  @@index([editorialPriority])
  @@index([geohash])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "places_name_trgm_idx", type: Gin)
  @@index([searchVector], map: "places_search_idx", type: Gin)
  @@index([status])
  @@map("places")
}

model PlaceImage {
