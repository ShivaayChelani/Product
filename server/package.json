{
  "name": "palsasafar-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=1024 tsc --project tsconfig.build.json && prisma generate",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "start": "node --max-old-space-size=512 dist/src/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:all": "ts-node prisma/seed.ts",
    "db:fetch:osm": "node ../scripts/fetch-india-places-expand.cjs",
    "db:import:india": "ts-node scripts/import-india-tourist-places.ts",
    "db:backfill:ratings": "ts-node scripts/import-india-tourist-places.ts --backfill-ratings",
    "db:canonical:ingest": "ts-node scripts/ingest-canonical-place.ts",
    "db:canonical:dedupe": "ts-node scripts/canonical-dedupe-places.ts --dry-run",
    "test:canonical": "vitest run src/__tests__/canonical.test.ts src/__tests__/places-public-visibility.test.ts src/__tests__/geohash-duplicate-scan.test.ts src/__tests__/boundary-dataset.test.ts src/__tests__/canonical-pick.test.ts",
    "job:india-corpus-dedupe": "ts-node scripts/jobs/india-corpus-dedupe.ts",
    "db:report:quality": "ts-node scripts/database-quality-report.ts",
    "db:wikidata:fetch": "ts-node scripts/wikidata-coverage-fetch.ts",
    "db:wikidata:ingest": "ts-node scripts/wikidata-coverage-ingest.ts",
    "bench:canonical": "ts-node scripts/benchmarks/canonical-bench.ts",
    "job:duplicate-scan": "ts-node scripts/jobs/nightly-duplicate-scan.ts",
    "job:boundary-scan": "ts-node scripts/jobs/boundary-validation-scan.ts",
    "job:factual-enrichment": "ts-node scripts/jobs/run-factual-enrichment.ts",
    "job:factual-enrichment:all": "ts-node scripts/jobs/run-factual-enrichment-all.ts",
    "job:factual-enrichment:supervisor": "ts-node scripts/jobs/run-factual-enrichment-supervisor.ts",
    "job:completeness-scores": "ts-node scripts/jobs/recalculate-completeness-scores.ts --all",
    "job:enterprise-report": "ts-node scripts/jobs/enterprise-quality-report.ts",
    "job:resolve-external-ids": "ts-node scripts/jobs/resolve-external-ids.ts",
    "job:final-enterprise-report": "ts-node scripts/jobs/enterprise-quality-report.ts --final",
    "job:enterprise-pipeline": "ts-node scripts/jobs/run-enterprise-pipeline.ts --phase=all",
    "job:data-integrity": "ts-node scripts/jobs/run-data-integrity-pipeline.ts --phase=all",
    "job:fill-core-fields": "ts-node scripts/jobs/fill-india-core-fields.ts",
    "db:import:bulk": "ts-node scripts/bulk-tourist-import.ts",
    "job:image-pipeline": "ts-node scripts/jobs/image-pipeline-scan.ts",
    "job:embedding-refresh": "ts-node scripts/jobs/embedding-refresh.ts",
    "job:image-url-scan": "ts-node scripts/jobs/image-url-scan.ts",
    "db:strip:synthetic-ratings": "ts-node scripts/strip-synthetic-ratings.ts --dry-run",
    "db:cleanup:dev-data": "ts-node scripts/production-dev-data-cleanup.ts --dry-run",
    "db:cleanup:dev-data:apply": "ts-node scripts/production-dev-data-cleanup.ts --apply --confirm=I_UNDERSTAND_PRODUCTION",
    "db:clear-places": "ts-node scripts/remove-all-places.ts",
    "db:dedupe": "node scripts/remove-place-duplicates.cjs",
    "db:dedupe:dry": "node scripts/remove-place-duplicates.cjs --dry-run",
    "db:purge:junk": "ts-node scripts/purge-junk-places.ts",
    "db:purge:junk:dry": "ts-node scripts/purge-junk-places.ts --dry-run",
    "db:cleanup:places": "node scripts/cleanup-genuine-places.cjs",
    "db:extract:curated": "node ../scripts/extract-curated-places.cjs",
    "test": "npm run test:all",
    "test:unit": "vitest run --config vitest.unit.config.js",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:e2e": "vitest run --config vitest.e2e.config.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "validate:env": "ts-node scripts/validate-production-env.ts --profile=closed-beta",
    "job:places-backfill": "ts-node scripts/jobs/places-corpus-backfill.ts",
    "job:places-geocode": "ts-node scripts/jobs/places-metadata-geocode-backfill.ts",
    "smoke:smtp": "ts-node scripts/smoke-smtp.ts",
    "beta:gate": "npm run typecheck && npm run lint && npm run test:unit",
    "smoke:health": "ts-node scripts/smoke-health.ts",
    "test:watch": "vitest --config vitest.config.js",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "db:studio": "prisma studio",
    "verify:credentials": "node scripts/verify-credentials.cjs",
    "db:prune-users": "ts-node scripts/prune-extra-users.ts",
    "db:sync:admins": "ts-node scripts/sync-admin-users.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@sentry/node": "^10.54.0",
    "@sentry/profiling-node": "^10.54.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.6.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.0.0",
    "googleapis": "^148.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "uuid": "^14.0.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.2",
    "@types/node-fetch": "^2.6.13",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.1",
    "prisma": "^6.6.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.7"
  }
}
