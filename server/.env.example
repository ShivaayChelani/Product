# ── Server ──
PORT=5000
NODE_ENV=development

# ── Database (Render PostgreSQL in production; local PostGIS for tests) ──
# Runtime connection (Render external URL or local Postgres)
DATABASE_URL=postgresql://user:password@your-host:5432/db?sslmode=require
# Direct connection for prisma migrate deploy (often same as DATABASE_URL on Render)
DIRECT_URL=postgresql://user:password@your-host:5432/db?sslmode=require

# Set to 1 only for one-off search vector rebuilds (touches every place row — not for routine deploys)
# REBUILD_PLACE_SEARCH_VECTORS=0

# ── Auth ──
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=1h

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Client ──
CLIENT_URL=http://localhost:3000

# ── Firebase Cloud Messaging (for push notifications) ──
# Method A — explicit service account (Render, local dev, any host without GCP metadata):
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR PRIVATE KEY\n-----END PRIVATE KEY-----\n"
# Alternative to FIREBASE_PRIVATE_KEY: path to a PEM file on disk
# FIREBASE_PRIVATE_KEY_PATH=/path/to/firebase-private-key.pem
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
#
# Method B — Application Default Credentials (GCP Cloud Run, GKE Workload Identity, GCE):
# Omit FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY*; the runtime resolves credentials
# automatically. Optionally keep FIREBASE_PROJECT_ID and FIREBASE_STORAGE_BUCKET above.
# Local ADC: gcloud auth application-default login, or set GOOGLE_APPLICATION_CREDENTIALS
# to a service account JSON key file path.

# ── Sentry (optional) ──
SENTRY_DSN=

# ── Email (required for forgot-password / register OTP) ──
# Production on Render: use Brevo HTTPS API (SMTP ports 587/465 often time out).
# Create an API key: https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=xkeysib-...
# SMTP_FROM_EMAIL=rahul@palsafar.in
# SMTP_FROM_NAME=PalSafar
#
# Brevo transactional templates — when BREVO_API_KEY is set and these IDs are
# present, the backend sends templateId + params {code, appUrl} and Brevo's
# dashboard becomes the source of truth for the email body/design. Template
# bodies must use {{params.code}} and {{params.appUrl}} placeholders.
# Missing IDs cause a 503 configuration error while the Brevo API is active.
BREVO_EMAIL_VERIFICATION_TEMPLATE_ID=2
BREVO_PASSWORD_RESET_TEMPLATE_ID=4
#
# Option A — Gmail App Password (local testing via SMTP):
#   1. Enable 2-Step Verification
#   2. Create an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-app-password-or-key
SMTP_FROM_EMAIL=your-verified-sender@example.com
SMTP_FROM_NAME=PalSafar
#
# Option B — Brevo SMTP relay (may fail on Render; prefer BREVO_API_KEY above):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-smtp-login@example.com
# SMTP_PASS=your-brevo-smtp-key
# Optional SMTP tuning (defaults shown)
# SMTP_CONNECTION_TIMEOUT_MS=30000
# SMTP_GREETING_TIMEOUT_MS=30000
# SMTP_SOCKET_TIMEOUT_MS=60000
# SMTP_MAX_RETRIES=2

# ── AI (optional — enables trip planner / discover) ──
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Redis (optional — for distributed cache/rate limits in multi-instance deploys) ──
REDIS_URL=

# ── Seed / test accounts (development only) ──
# In production, credential sync is OFF unless SYNC_CANONICAL_CREDENTIALS=true (demo DBs only).
# In development, sync runs unless explicitly set to false.
SYNC_CANONICAL_CREDENTIALS=false
SYNC_CURATED_PLACES=false
# Demo Street Story vendor + Rahul Chelani creator seed. Auto-on in development;
# OFF in production unless SEED_STREET_STORY=true (disposable demo DBs only).
# SEED_STREET_STORY=false
# Itinerary GPS checkpoint PalPoints (requires attestation for production trust).
# Default: enabled in development, disabled in production until ITINERARY_GPS_REWARDS_ENABLED=true.
# ITINERARY_GPS_REWARDS_ENABLED=false
# ITINERARY_CHECKPOINT_RADIUS_METERS=100
# ITINERARY_GPS_ACCURACY_MAX_METERS=50
# ITINERARY_MAX_TRAVEL_SPEED_KMH=120
# OPT-IN: delete every user except the 4 canonical test accounts on startup.
# Leave unset/false in production so real signups are kept across restarts.
PRUNE_EXTRA_USERS=false
SEED_VENDOR_PASSWORD=change-me-vendor-seed
SEED_CREATOR_PASSWORD=change-me-creator-seed
SEED_VENDOR_EMAIL=vendor@example.com

# OPT-IN: delete places with coordinates (0,0) on startup — never enable on production without review
# CLEANUP_NULL_ISLAND_PLACES=false

# ── Automated tests (Vitest) — see docs/TESTING.md ──
# Tests use TEST_DATABASE_URL, NOT DATABASE_URL above.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/palsafar_test?connection_limit=3
# TEST_DIRECT_URL=postgresql://postgres:postgres@localhost:5433/palsafar_test
# PRODUCTION_DATABASE_URL=   # optional guard — refuse tests if TEST URL matches this

# ── Payments (Razorpay — vendor/creator subscriptions) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# ── Mobile IAP (optional — Google Play / Apple App Store) ──
GOOGLE_PLAY_PACKAGE_NAME=com.palsasafar
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=
APPLE_IAP_ENV=production

# ── Places / search feature flags ──
PLACES_PUBLIC_VERIFIED_ONLY=false
HYBRID_SEARCH_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small

# ── Licensed boundary datasets (requires legal approval) ──
BOUNDARY_DATA_DIR=
BOUNDARY_DATA_LICENSE_ACKNOWLEDGED=false

# ── HTTP timeouts ──
REQUEST_TIMEOUT=10000
