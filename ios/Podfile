# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Match Android (gradle.properties newArchEnabled=false). RN 0.81 defaults New Arch ON
# unless RCT_NEW_ARCH_ENABLED=0 — keep both platforms on the Legacy Architecture.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Firebase: static frameworks avoid modular-header conflicts with use_frameworks.
# Override with USE_FRAMEWORKS=dynamic|static if needed.
$RNFirebaseAsStaticFramework = true
linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

# react-native-permissions — only pods for capabilities the app actually uses
require_relative '../node_modules/react-native-permissions/scripts/setup'
setup_permissions([
  'Camera',
  'LocationWhenInUse',
  'PhotoLibrary',
  'PhotoLibraryAddOnly',
  'Notifications',
  'Microphone',
])

target 'PalSafar' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.1
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
    end
  end
end
