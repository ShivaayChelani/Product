# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Match Android (gradle.properties newArchEnabled=false). RN 0.81 defaults New Arch ON
# unless RCT_NEW_ARCH_ENABLED=0 — keep both platforms on the Legacy Architecture.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Firebase: static frameworks avoid modular-header conflicts with use_frameworks.
# Override with USE_FRAMEWORKS=dynamic|static if needed.
$RNFirebaseAsStaticFramework = true
linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

# react-native-permissions — only pods for capabilities the app actually uses
require_relative '../node_modules/react-native-permissions/scripts/setup'
setup_permissions([
  'Camera',
  'LocationWhenInUse',
  'PhotoLibrary',
  'PhotoLibraryAddOnly',
  'Notifications',
  'Microphone',
])

# ── fmt consteval workaround ────────────────────────────────────────────────
# fmt 11.0.2 (pinned by react-native 0.81.5 via third-party-podspecs/fmt.podspec)
# sets FMT_USE_CONSTEVAL=1 on Apple clang >= 14 (Xcode 26.6 on the GitHub runner)
# because ios/Pods/fmt/include/fmt/base.h auto-detects __cpp_consteval without
# honouring an externally supplied FMT_USE_CONSTEVAL. That consteval format-string
# parser then fails to compile on Xcode 26's clang with:
#   error: call to consteval function 'fmt::detail::parse_format_string<...>'
#          is not a constant expression
# (fmt/src/format.cc -> include/fmt/format-inl.h).
# This hook forces FMT_USE_CONSTEVAL=0 in the pod's generated base.h on every
# `pod install` (local and CI). It is idempotent and raises loudly if the
# expected fmt 11.x block is missing or changes shape, so it can never silently
# stop applying.
def patch_fmt_consteval!(installer)
  base_h = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
  raise "fmt base.h not found at #{base_h} — fmt consteval workaround cannot be applied" unless File.exist?(base_h)

  content = File.read(base_h)
  block_marker = '// Detect consteval, C++20 constexpr extensions and std::is_constant_evaluated.'
  unless content.include?(block_marker)
    raise "fmt #{base_h} is missing the FMT_USE_CONSTEVAL detection block — fmt workaround is out of date"
  end

  sentinel = '#  define FMT_USE_CONSTEVAL 0  // PalSafar: disable consteval (Xcode 26)'
  return if content.include?(sentinel) # already patched by a previous pod install

  from = "#elif defined(__cpp_consteval)\n#  define FMT_USE_CONSTEVAL 1\n#elif FMT_GCC_VERSION >= 1002 || FMT_CLANG_VERSION >= 1101\n#  define FMT_USE_CONSTEVAL 1"
  to = "#elif defined(__cpp_consteval)\n#{sentinel}\n#elif FMT_GCC_VERSION >= 1002 || FMT_CLANG_VERSION >= 1101\n#{sentinel}"

  patched = content.sub(from, to)
  if patched == content
    raise "fmt #{base_h} FMT_USE_CONSTEVAL block does not match the expected fmt 11.0.x source — fmt workaround is out of date"
  end

  File.write(base_h, patched)
  Pod::UI.puts "fmt: forced FMT_USE_CONSTEVAL=0 in #{base_h}".green
end

target 'PalSafar' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    # fmt 11.0.2 base.h must ship with consteval disabled for Xcode 26's clang.
    patch_fmt_consteval!(installer)

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.1
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end

        # CI passes the App Store signing settings on the xcodebuild command
        # line, so xcodebuild applies them to every target in the workspace,
        # including Pods. Pods targets don't support provisioning profiles.
        # Disable/clear signing on Pods only - the PalSafar app target keeps
        # its manual App Store signing from the project + ExportOptions.
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        config.build_settings.delete('PROVISIONING_PROFILE_SPECIFIER')
        config.build_settings.delete('PROVISIONING_PROFILE')
      end

      # Pin Swift 5 for pods that have Swift 6 concurrency warnings.
      # These warnings are benign but cause archive failures if SWIFT_TREAT_WARNINGS_AS_ERRORS is on.
      swift5_targets = %w[react-native-compressor RNVideo]
      if swift5_targets.include?(target.name)
        target.build_configurations.each do |config|
          config.build_settings['SWIFT_VERSION'] = '5.0'
        end
      end
    end
  end
end
