# ─────────────────────────────────────────────────────────────────────────────
# PalSafar Environment Template
# Copy to .env and fill in real values (never commit .env to git).
# ─────────────────────────────────────────────────────────────────────────────

# Server API URL
# MUST include /api/v1 — backend mounts auth at POST /api/v1/auth/register
# Android emulator uses 10.0.2.2 to reach the host machine
PALSAFAR_API_URL=http://localhost:5000/api/v1

# Mobile crash reporting (Sentry)
SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────────────────────
# Mapbox — Map Rendering + Directions API
# ─────────────────────────────────────────────────────────────────────────────

# PUBLIC access token (pk. ...) — embedded in the app bundle. Safe to include in builds.
# Required scopes: MAPS:READ, NAVIGATION:READ
# Get your token from: https://console.mapbox.com/account/access-tokens/
#
# Set this same value in:
#   • android/app/src/main/res/values/mapbox_access_token.xml  (Android native)
#   • ios/PalSafar/Info.plist → MBXAccessToken key             (iOS native)
#   • App.tsx → MAPBOX_PUBLIC_TOKEN const                       (JS / Directions API)
#
# (This .env variable is for documentation only — the app reads the above files directly)
MAPBOX_PUBLIC_TOKEN=pk.REPLACE_ME_WITH_YOUR_MAPBOX_PUBLIC_TOKEN

# SECRET Downloads token (sk. ...) — required by Gradle to download the Mapbox Android AAR.
# NEVER commit this token. NEVER put it in AndroidManifest, APK, or the JS bundle.
# Add it to ~/.gradle/gradle.properties on each developer machine:
#   MAPBOX_DOWNLOADS_TOKEN=sk.eyJ1IjoiWU9VUl9VU0VSTkFNRSIsImEiOiJZT1VS...
# Or export as environment variable before building Android.
# MAPBOX_DOWNLOADS_TOKEN=sk.REPLACE_ME_WITH_YOUR_SECRET_DOWNLOADS_TOKEN
