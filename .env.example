# Server API URL (documentation / future env wiring)
# MUST include /api/v1 — backend mounts auth at POST /api/v1/auth/register
# Android emulator uses 10.0.2.2 to reach the host machine
PALSAFAR_API_URL=http://localhost:5000/api/v1

# Mobile crash reporting (Sentry). Prefer src/config/monitoring.local.ts for local
# overrides, or inject SENTRY_DSN at bundle/CI time.
SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development
