# PalSafar Admin Dashboard
# Copy this to .env.local and fill in your values

# URL of the running PalSafar API server (server-side login + proxy)
# Local:  http://localhost:5000/api/v1
# Prod:   set API_URL in your host (Vercel/etc). Required in production.
# Must include /api/v1 (origin-only is auto-normalized, but prefer the full path).
API_URL=http://localhost:5000/api/v1

# Optional fallback used only when API_URL is unset (prefer API_URL alone).
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Production example:
# API_URL=https://palsafar-api-fh7i.onrender.com/api/v1
