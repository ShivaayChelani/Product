{
  "name": "palsasafar",
  "version": "1.1.0",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ App.tsx",
    "test": "jest --passWithNoTests",
    "build:android": "cd android && ./gradlew assembleRelease",
    "clean:android": "cd android && ./gradlew clean",
    "pods": "cd ios && bundle exec pod install",
    "pods:update": "cd ios && bundle exec pod install --repo-update",
    "ios:setup": "node scripts/ios-setup.js",
    "build:ios": "cd ios && xcodebuild -workspace PalSafar.xcworkspace -scheme PalSafar -configuration Release -sdk iphoneos -destination 'generic/platform=iOS' build",
    "generate:icons": "node scripts/generate-app-icons.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/auth": "^25.1.0",
    "@react-native-firebase/messaging": "^25.1.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "@sentry/react-native": "^8.19.0",
    "@shopify/flash-list": "^1.8.3",
    "@tanstack/react-query": "^5.101.4",
    "razorpay": "^2.9.8",
    "react": "19.1.0",
    "react-hook-form": "^7.83.0",
    "react-native": "0.81.5",
    "react-native-compressor": "^1.10.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-fs": "^2.20.0",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-google-mobile-ads": "^16.4.0",
    "react-native-image-picker": "^7.2.3",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-permissions": "^5.6.0",
    "react-native-reanimated": "~3.19.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.5",
    "react-native-vector-icons": "^10.2.0",
    "react-native-video": "^6.19.2",
    "react-native-webview": "^13.16.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@eslint/js": "^10.0.1",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@react-native/typescript-config": "0.81.5",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "sharp": "^0.35.3",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.61.0"
  },
  "engines": {
    "node": ">=18"
  }
}
