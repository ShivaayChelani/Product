<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release: block cleartext HTTP globally. Debug builds replace this file
         via src/debug/res/xml/network_security_config.xml.
         Do NOT use <debug-overrides> for cleartext: that element only accepts
         <trust-anchors>, so a nested <base-config> is silently ignored and
         Metro (ws://localhost:8081) cannot connect. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
